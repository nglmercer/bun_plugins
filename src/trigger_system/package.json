{
  "name": "trigger_system",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "bun run build:node && bun run build:browser",
    "build:node": "bun build src/index.ts --outdir dist/node --target node --minify --sourcemap=external",
    "build:browser": "bun build src/index.browser.ts --outdir dist/browser --target browser --minify --sourcemap=external",
    "test": "bun test",
    "validate": "bun run src/cli/validate.ts",
    "lsp": "bun run src/lsp/server.ts --stdio"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "arktype": "^2.1.29",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.8.2"
  }
}
