{
  "name": "bun_plugins",
  "version": "1.0.0",
  "description": "A powerful and secure plugin system for Bun applications",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "bun test ./tests",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "trigger_system": "^1.0.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "zod": "^3.23.0"
  }
}
