{
  "name": "bun_plugins",
  "version": "1.2.4",
  "description": "A powerful and secure plugin system for Bun applications",
  "author": "memelser <nglmercer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nglmercer/bun_plugins.git"
  },
  "bugs": {
    "url": "https://github.com/nglmercer/bun_plugins/issues"
  },
  "homepage": "https://github.com/nglmercer/bun_plugins#readme",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./src/types/plugin-registry-base": {
      "types": "./dist/src/types/plugin-registry-base.d.ts"
    }
  },
  "scripts": {
    "build": "bun tsc",
    "test": "bun test ./tests",
    "typecheck": "bun tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "arktype": "^2.1.0",
    "semver": "^7.7.3",
    "zod": "^4.3.5"
  }
}
